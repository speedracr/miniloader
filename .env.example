# Copy this file to .env and fill in real values. Never commit .env.
# .env is loaded only when this app runs locally/on the Nucbox.

# --- Backblaze B2 (S3-compatible API) ---
# Application key with write access to a single bucket, created in the B2 console.
B2_KEY_ID=changeme
B2_APPLICATION_KEY=changeme
B2_BUCKET=changeme
# e.g. https://s3.us-west-004.backblazeb2.com
B2_ENDPOINT=https://s3.REGION.backblazeb2.com
# e.g. us-west-004
B2_REGION=us-west-004
# Public friendly URL prefix for the bucket, e.g. https://f004.backblazeb2.com/file/my-bucket
B2_PUBLIC_URL_BASE=https://fXXX.backblazeb2.com/file/changeme

# --- Caller authentication ---
# Comma-separated list of "name:token" pairs, one per calling service.
# Generate tokens with: ruby -rsecurerandom -e 'puts SecureRandom.hex(32)'
MINILOADER_TOKENS=hermes:changeme,podcast_maker:changeme

# --- Server ---
MINILOADER_BIND=127.0.0.1
MINILOADER_PORT=4567
MINILOADER_DB_PATH=db/miniloader.sqlite3
# Optional. When set, callers may upload by local path ({"path": "..."}) instead
# of sending the file over HTTP, as long as the path resolves inside this directory.
# Leave unset to disable path-based uploads entirely (multipart file upload still works).
# MINILOADER_LOCAL_PATH_ROOT=/home/you/drop

# --- Guardrails (defaults shown) ---
MINILOADER_MAX_UPLOAD_BYTES=2147483648
MINILOADER_ALLOWED_EXTENSIONS=.mp3,.wav,.flac,.m4a,.mp4,.mkv,.mov,.pdf
MINILOADER_RATE_LIMIT_PER_MINUTE=5
MINILOADER_MAX_CONCURRENT_UPLOADS=2
MINILOADER_MAX_CONCURRENT_UPLOADS_PER_CALLER=1
MINILOADER_DAILY_BYTE_QUOTA=10737418240
MINILOADER_MONTHLY_BYTE_QUOTA=107374182400
